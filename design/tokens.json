{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Design system for an open-source library of Claude Skills for travel and tourism professionals. One skill per profession, grounded in field interviews and ground-truth material.",
  "color": {
    "$type": "color",
    "primary": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "on-primary": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } },
    "secondary": { "$value": { "colorSpace": "srgb", "components": [0.816, 0.725, 0.51], "hex": "#d0b982" } },
    "on-secondary": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } },
    "neutral": { "$value": { "colorSpace": "srgb", "components": [0.153, 0.153, 0.165], "hex": "#27272a" } },
    "on-neutral": { "$value": { "colorSpace": "srgb", "components": [0.98, 0.98, 0.98], "hex": "#fafafa" } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } },
    "on-surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "on-surface-display": { "$value": { "colorSpace": "srgb", "components": [0.941, 0.929, 0.906], "hex": "#f0ede7" } },
    "on-surface-muted": { "$value": { "colorSpace": "srgb", "components": [0.612, 0.639, 0.686], "hex": "#9ca3af" } },
    "surface-container": { "$value": { "colorSpace": "srgb", "components": [0.098, 0.106, 0.141], "hex": "#191b24" } },
    "surface-container-high": { "$value": { "colorSpace": "srgb", "components": [0.133, 0.141, 0.18], "hex": "#22242e" } },
    "outline": { "$value": { "colorSpace": "srgb", "components": [0.165, 0.176, 0.22], "hex": "#2a2d38" } },
    "inverse-surface": { "$value": { "colorSpace": "srgb", "components": [0.941, 0.929, 0.906], "hex": "#f0ede7" } },
    "on-inverse-surface": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } },
    "success": { "$value": { "colorSpace": "srgb", "components": [0.063, 0.725, 0.506], "hex": "#10b981" } },
    "on-success": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } },
    "info": { "$value": { "colorSpace": "srgb", "components": [0.545, 0.361, 0.965], "hex": "#8b5cf6" } },
    "on-info": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } },
    "error": { "$value": { "colorSpace": "srgb", "components": [0.937, 0.267, 0.267], "hex": "#ef4444" } },
    "on-error": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.055], "hex": "#0a0a0e" } }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "2xl": { "$value": { "value": 32, "unit": "px" } },
    "3xl": { "$value": { "value": 48, "unit": "px" } },
    "4xl": { "$value": { "value": 64, "unit": "px" } },
    "5xl": { "$value": { "value": 96, "unit": "px" } },
    "6xl": { "$value": { "value": 128, "unit": "px" } }
  },
  "rounded": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" } },
    "lg": { "$value": { "value": 12, "unit": "px" } },
    "xl": { "$value": { "value": 16, "unit": "px" } },
    "2xl": { "$value": { "value": 24, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 4, "unit": "rem" },
        "fontWeight": 600,
        "letterSpacing": { "value": -0.02, "unit": "em" },
        "lineHeight": { "value": 4.25, "unit": "rem" }
      }
    },
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 2.5, "unit": "rem" },
        "fontWeight": 600,
        "letterSpacing": { "value": -0.015, "unit": "em" },
        "lineHeight": { "value": 2.75, "unit": "rem" }
      }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 1.5, "unit": "rem" },
        "fontWeight": 600,
        "letterSpacing": { "value": -0.01, "unit": "em" },
        "lineHeight": { "value": 1.875, "unit": "rem" }
      }
    },
    "title-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 1.25, "unit": "rem" },
        "fontWeight": 600,
        "letterSpacing": { "value": -0.005, "unit": "em" },
        "lineHeight": { "value": 1.625, "unit": "rem" }
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 1, "unit": "rem" },
        "fontWeight": 400,
        "lineHeight": { "value": 1.5, "unit": "rem" }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 0.875, "unit": "rem" },
        "fontWeight": 400,
        "lineHeight": { "value": 1.3125, "unit": "rem" }
      }
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist, system-ui, sans-serif",
        "fontSize": { "value": 0.75, "unit": "rem" },
        "fontWeight": 500,
        "letterSpacing": { "value": 0.02, "unit": "em" },
        "lineHeight": { "value": 1, "unit": "rem" }
      }
    },
    "mono-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist Mono, ui-monospace, monospace",
        "fontSize": { "value": 0.8125, "unit": "rem" },
        "fontWeight": 400,
        "lineHeight": { "value": 1.25, "unit": "rem" }
      }
    }
  }
}
